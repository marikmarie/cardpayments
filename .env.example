# The hosted-link API is the safe default. Enable direct card data only after
# PCI DSS controls are in place; never enable it for browser clients.
DIRECT_CARD_PAYMENTS_ENABLED="false"

# Create a separate CyberSource Webhooks Digital Signature Key. This is not
# your REST shared secret; it validates the v-c-signature header on callbacks.
CYBERSOURCE_WEBHOOK_KEY_ID=""
CYBERSOURCE_WEBHOOK_SHARED_SECRET=""
CYBERSOURCE_WEBHOOK_TOLERANCE_SECONDS="300"
