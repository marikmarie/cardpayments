


APP_NAME="CissyTech Payments"
# Production when the app is deployed at the Collecto domain root.
# APP_URL="https://collecto.cissytech.com"
APP_URL="http://localhost:8000"
APP_DEBUG="false"
STORAGE_PATH="storage/data.json"

# MySQL is used whenever DB_DSN is configured.
DB_DSN="mysql:host=localhost;dbname=your_database;charset=utf8mb4"
DB_USER="your_database_user"
DB_PASSWORD="your_database_password"

# Use `live` with production REST credentials. Test and production keys are separate.
CYBERSOURCE_ENV="live"
CYBERSOURCE_MERCHANT_ID=""
CYBERSOURCE_KEY_ID=""
CYBERSOURCE_SHARED_SECRET=""

# Separate from the REST key above. These validate CyberSource webhooks.
CYBERSOURCE_WEBHOOK_KEY_ID=""
CYBERSOURCE_WEBHOOK_SHARED_SECRET=""
CYBERSOURCE_WEBHOOK_TOLERANCE_SECONDS="300"

# PegPay Payments and Collections API. Pegasus must issue the URL and vendor credentials.
# `private.key` is resolved from this project folder and must never be committed.
PEGASUS_API_URL=""
PEGASUS_VENDOR_CODE=""
PEGASUS_PASSWORD=""
PEGASUS_PRIVATE_KEY_PATH="private.key"
PEGASUS_PRIVATE_KEY_PASSPHRASE=""
PEGASUS_CLIENT_IP=""

# PegPay hosted checkout for card and mobile-money collections. These are separate
# from the Payments and Collections API credentials above. Never commit real values.
PEGASUS_WEB_GATEWAY_URL=""
# PegPay Web's HTTPS QueryStatus.aspx endpoint. For the supplied test checkout URL
# (.../PaymentsGatewayTest/Default.aspx), use .../PaymentsGatewayTest/QueryStatus.aspx.
# Obtain the production endpoint from Pegasus.
PEGASUS_WEB_STATUS_URL=""
PEGASUS_WEB_VENDOR_CODE=""
PEGASUS_WEB_PASSWORD=""
PEGASUS_WEB_SECRET_CODE=""
PEGASUS_WEB_MERCHANT_CODE=""
# Leave blank to use APP_URL/pegasus-card/return.
PEGASUS_WEB_RETURN_URL=""
# Leave blank to write redacted card-checkout events to storage/pegasus-card.log.
PEGASUS_CARD_LOG_DIRECTORY=""

# EFRIS starts in mock mode. It accepts vendor test calls but sends nothing to URA.
EFRIS_MODE="mock"
