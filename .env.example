APP_NAME="CissyTech Payments"
# APP_URL="https://mariam.cissytech.com/cardpayments"
APP_URL="http://localhost:8000"
APP_DEBUG="false"
STORAGE_PATH="storage/data.json"

# MySQL is used whenever DB_DSN is configured.
DB_DSN="mysql:host=localhost;dbname=your_database;charset=utf8mb4"
DB_USER="your_database_user"
DB_PASSWORD="your_database_password"

# Use `live` with production REST credentials. Test and production keys are separate.
CYBERSOURCE_ENV="live"
CYBERSOURCE_MERCHANT_ID=""
CYBERSOURCE_KEY_ID=""
CYBERSOURCE_SHARED_SECRET=""

# Separate from the REST key above. These validate CyberSource webhooks.
CYBERSOURCE_WEBHOOK_KEY_ID=""
CYBERSOURCE_WEBHOOK_SHARED_SECRET=""
CYBERSOURCE_WEBHOOK_TOLERANCE_SECONDS="300"

# EFRIS starts in mock mode. It accepts vendor test calls but sends nothing to URA.
# Do not save a URA private key, AES key or certificate in this file.
EFRIS_MODE="mock"
