{
  "openapi": "3.1.0",
  "info": {
    "title": "CissyTech EFRIS Gateway API",
    "version": "0.1.0",
    "description": "A tenant-scoped gateway for POS and ERP systems. The authenticated CissyTech API key determines the company; clients cannot provide a seller TIN, EFRIS device, certificate or AES key. This release supports mock-mode integration testing only and does not issue URA fiscal documents."
  },
  "servers": [
    {
      "url": "http://localhost:8000"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    },
    "parameters": {
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "description": "A unique value for this invoice attempt. Repeating the same value with the same body is safe; reusing it with different data returns 409.",
        "schema": {
          "type": "string",
          "maxLength": 100
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error"],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "InvoiceInput": {
        "type": "object",
        "required": ["external_reference", "branch_code", "total_amount", "currency", "payment_method", "items"],
        "properties": {
          "external_reference": {
            "type": "string",
            "maxLength": 100,
            "example": "POS-INV-000172"
          },
          "branch_code": {
            "type": "string",
            "example": "KAMPALA-01"
          },
          "total_amount": {
            "type": "string",
            "pattern": "^\\d{1,15}(\\.\\d{1,4})?$",
            "example": "50000.00"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "example": "UGX"
          },
          "payment_method": {
            "type": "string",
            "description": "Use a payment method mapped for this tenant from the current URA dictionary.",
            "example": "MOBILE_MONEY"
          },
          "buyer": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "example": "B2C"
              },
              "name": {
                "type": "string",
                "example": "Cash Customer"
              },
              "tin": {
                "type": "string",
                "description": "Only include when the applicable URA invoice rule requires the buyer TIN."
              }
            }
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["product_code", "quantity", "unit_price"],
              "properties": {
                "product_code": {
                  "type": "string",
                  "example": "ITEM-001"
                },
                "quantity": {
                  "type": "string",
                  "example": "2"
                },
                "unit_price": {
                  "type": "string",
                  "example": "25000.00"
                },
                "discount": {
                  "type": "string",
                  "example": "0.00"
                }
              }
            }
          }
        }
      },
      "Invoice": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "external_reference": {
            "type": "string"
          },
          "branch_code": {
            "type": "string"
          },
          "total_amount": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "example": "TEST_ACCEPTED"
          },
          "ura_status": {
            "type": "string",
            "example": "NOT_SUBMITTED"
          },
          "fiscal_document_number": {
            "type": ["string", "null"]
          },
          "verification_code": {
            "type": ["string", "null"]
          },
          "qr_data": {
            "type": ["string", "null"]
          },
          "test_mode": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "paths": {
    "/api/v1/efris/health": {
      "get": {
        "summary": "Gateway health and mode",
        "security": [],
        "responses": {
          "200": {
            "description": "Gateway state"
          }
        }
      }
    },
    "/api/v1/efris/branches": {
      "get": {
        "summary": "List the authenticated tenant's active branches",
        "responses": {
          "200": {
            "description": "Branch list"
          },
          "401": {
            "description": "Invalid API key"
          },
          "403": {
            "description": "API key is not assigned to an EFRIS tenant"
          }
        }
      }
    },
    "/api/v1/efris/invoices": {
      "post": {
        "summary": "Create an idempotent fiscalisation request",
        "parameters": [
          {
            "$ref": "#/components/parameters/IdempotencyKey"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InvoiceInput"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted in mock mode; no data was submitted to URA."
          },
          "400": {
            "description": "Missing Idempotency-Key or invalid JSON"
          },
          "401": {
            "description": "Invalid API key"
          },
          "409": {
            "description": "Reference or idempotency key reused with a different body"
          },
          "422": {
            "description": "Tenant, branch, or input validation failed"
          },
          "503": {
            "description": "Live transport is not yet configured"
          }
        }
      }
    },
    "/api/v1/efris/invoices/{external_reference}": {
      "get": {
        "summary": "Retrieve a tenant-scoped local fiscalisation record",
        "parameters": [
          {
            "name": "external_reference",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Local fiscalisation record"
          },
          "401": {
            "description": "Invalid API key"
          },
          "404": {
            "description": "No record exists for this tenant"
          }
        }
      }
    }
  }
}
