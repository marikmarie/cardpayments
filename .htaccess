Options -Indexes
DirectoryIndex public/index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    # The project can be uploaded as-is to public_html/cardpayments.
    # Only files below public/ are ever served by Apache.
    RewriteRule ^public/ - [L]
    RewriteRule ^$ public/index.php [L]
    RewriteRule ^(.+)$ public/$1 [L]
</IfModule>
